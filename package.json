{
  "name": "calamox-bridge",
  "version": "0.1.0",
  "description": "Calamox Execution Bridge — local HTTP API for terminal execution and browser automation (Puppeteer).",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-static.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": [
    "calamox",
    "execution",
    "bridge",
    "automation",
    "puppeteer",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1",
    "puppeteer": "^25.7.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
