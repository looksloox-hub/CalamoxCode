# Calamox Bridge configuration (all optional)

# Bind address. Keep 127.0.0.1 unless you have a firewall + auth in front.
# CALAMOX_HOST=127.0.0.1

# Listen port
# CALAMOX_PORT=3000

# REQUIRED in any shared/remote environment: enables bearer-token auth on
# every /api route. Requests must send: Authorization: Bearer <token>
# CALAMOX_TOKEN=change-me

# Default timeout for POST /api/system/exec (ms)
# CALAMOX_EXEC_TIMEOUT_MS=120000

# Default timeout for POST /api/browser/open page loads (ms)
# CALAMOX_BROWSER_TIMEOUT_MS=60000

# Per-stream output capture cap for command execution (bytes)
# CALAMOX_MAX_OUTPUT_BYTES=10485760

# ─────────────────────────────────────────────────────────────────────────────
# Calamox backend LLM providers (all optional — set any one to enable chat)
# Keys can also be saved from the dashboard: Keys page → ~/.calamox/api_keys.json
# ─────────────────────────────────────────────────────────────────────────────

# OpenRouter: https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-...

# OpenCode Zen (free + pay-per-use): https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=sk-...

# Google Gemini (free tier available): https://aistudio.google.com/apikey
# GOOGLE_GEMINI_API_KEY=AIza...

# OpenAI / Anthropic / Groq
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
